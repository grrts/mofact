// Hub orders: once the guided goals are done, the hub asks for one of
// these at a time. Ship `count` of `item` to the hub within `minutes` and
// the order takes them out of the stock and pays `reward`. Each order
// shipped in a row adds a fifth to the next one's count and reward, up to
// three times as much; a missed order starts the streak over. An order is
// only asked for once its item has reached the hub, and the latest items
// the factory makes are asked for most.
[
    (id: "plates",       item: "iron-plate",   count: 400, minutes: 10.0,
        reward: [(item: "gear", count: 120), (item: "copper-plate", count: 120)]),
    (id: "gears",        item: "gear",         count: 150, minutes: 10.0,
        reward: [(item: "iron-plate", count: 300), (item: "wire", count: 120)]),
