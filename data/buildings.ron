// Buildings. `size` is (width, height) in tiles; `cost` is paid from the hub's stock.
[
    (id: "hub",       name: "Hub",       size: (3, 3), role: Hub, cost: []),
    (id: "belt",      name: "Belt",      size: (1, 1), role: Belt(tiles_per_second: 2.0),
        cost: [(item: "iron-plate", count: 1)]),
    (id: "drill",     name: "Drill",     size: (1, 1), role: Miner(seconds_per_ore: 1.2),
        cost: [(item: "iron-plate", count: 6)]),
    (id: "furnace",   name: "Furnace",   size: (1, 1), role: Crafter(categories: ["smelting"], speed: 1.0),
        cost: [(item: "iron-plate", count: 5)]),
    (id: "assembler", name: "Assembler", size: (1, 1), role: Crafter(categories: ["assembling"], speed: 1.0),
        cost: [(item: "iron-plate", count: 8), (item: "copper-plate", count: 4)]),
    // Tier 2: twice the belt's speed.
    (id: "fast-belt", name: "Fast belt", size: (1, 1), role: Belt(tiles_per_second: 4.0),
        cost: [(item: "gear", count: 1), (item: "iron-plate", count: 1)]),
    // Tier 3: three times the belt's speed.
    (id: "express-belt", name: "Express belt", size: (1, 1), role: Belt(tiles_per_second: 6.0),
        cost: [(item: "gear", count: 2), (item: "steel", count: 1)]),
    // Splits a line in two: items from behind go out left and right in turn.
    (id: "splitter",  name: "Splitter",  size: (1, 1), role: Splitter(mode: Even),
        cost: [(item: "circuit", count: 5), (item: "iron-plate", count: 5)]),
    // Splits a line in three: left, ahead and right in turn.
    (id: "three-way-splitter", name: "Three-way splitter", size: (1, 1), role: Splitter(mode: ThreeWay),
        cost: [(item: "circuit", count: 8), (item: "iron-plate", count: 8)]),
    // Feeds the line ahead first; only the overflow goes left and right.
    (id: "priority-splitter", name: "Priority splitter", size: (1, 1), role: Splitter(mode: Priority),
        cost: [(item: "circuit", count: 5), (item: "gear", count: 5), (item: "iron-plate", count: 5)]),
    // Sends one chosen item ahead and everything else left and right.
    (id: "filter-splitter", name: "Filter splitter", size: (1, 1), role: Splitter(mode: Filter),
        cost: [(item: "circuit", count: 10), (item: "iron-plate", count: 5)]),
    // A belt piece the other way round from a splitter: belts in from
    // behind and both sides take turns, one item at a time, onto the belt ahead.
    (id: "merger",    name: "Merger",    size: (1, 1), role: Splitter(mode: Merge),
        cost: [(item: "gear", count: 2), (item: "iron-plate", count: 2)]),
    // A store between belts: belts in on any side, out of its arrow. What
    // it holds is not the hub's stock.
    (id: "warehouse", name: "Warehouse", size: (2, 2), role: Warehouse(capacity: 1600),
        cost: [(item: "iron-plate", count: 20), (item: "gear", count: 10), (item: "brick", count: 10)]),
    // Takes from the warehouse, chest or hub behind it onto the belt ahead,
    // only while its condition on that store holds.
    (id: "picker", name: "Picker", size: (1, 1), role: Picker(per_second: 7.5),
        cost: [(item: "circuit", count: 3), (item: "gear", count: 3), (item: "iron-plate", count: 3)]),
    // Place an entrance, then an exit up to 5 tiles on, facing the same way.
    (id: "underground-belt", name: "Underground belt", size: (1, 1),
        role: Underground(tiles_per_second: 6.0, reach: 5),
        cost: [(item: "gear", count: 5), (item: "iron-plate", count: 10)]),
    // Labs eat research packs from belts, one unit of the current research at a time.
    (id: "lab",       name: "Lab",       size: (1, 1), role: Lab(speed: 1.0), power: 60.0,
        cost: [(item: "brick", count: 10), (item: "gear", count: 10), (item: "circuit", count: 5)]),
    // Power (T29): poles link within `wire` tiles and power what overlaps
    // the square `supply` tiles around them. `power` is kW drawn while working.
    (id: "pole",      name: "Pole",      size: (1, 1), role: Pole(wire: 7, supply: 2),
        cost: [(item: "iron-plate", count: 1), (item: "wire", count: 2)]),
    (id: "wind-turbine", name: "Wind turbine", size: (1, 1), role: Generator(kw: 60.0),
        cost: [(item: "iron-plate", count: 10), (item: "gear", count: 5), (item: "wire", count: 5)]),
    // The fog of war (S3): a powered radar lifts the fog from the nearest
    // hidden patch of land (32 tiles a side) every `seconds_per_patch`,
    // out to `reach` tiles, so far ore shows on the world map.
    (id: "radar",     name: "Radar",     size: (2, 2), role: Radar(reach: 1200, seconds_per_patch: 1.0), power: 60.0,
        cost: [(item: "iron-plate", count: 20), (item: "gear", count: 10), (item: "circuit", count: 10)]),
    // Drones (T49, T50): a powered port keeps `drones` drones, which fly
    // in a square `reach` tiles out from it each way. Ports whose squares
    // meet make one network. Drones bring requester chests what they ask
    // for from provider chests (or the hub) in the network, build the
    // ghosts planned there, and take away what is marked to go.
    (id: "drone-port", name: "Drone port", size: (2, 2), role: DronePort(drones: 4, reach: 25), power: 50.0,
        cost: [(item: "steel", count: 20), (item: "advanced-circuit", count: 10), (item: "drone", count: 4)]),
    (id: "provider-chest", name: "Provider chest", size: (1, 1), role: ProviderChest(capacity: 400),
        cost: [(item: "steel", count: 5), (item: "circuit", count: 3)]),
    (id: "requester-chest", name: "Requester chest", size: (1, 1), role: RequesterChest(capacity: 400),
        cost: [(item: "steel", count: 5), (item: "circuit", count: 3)]),
    // Fluids (T31): pipes, tanks and underground pipes join into segments
    // holding one fluid each; pumps move fluid between segments, and long
    // segments slow the flow. `capacity` and `per_second` are fluid units.
    (id: "pipe",      name: "Pipe",      size: (1, 1), role: Pipe(capacity: 100.0),
        cost: [(item: "iron-plate", count: 1)]),
    (id: "underground-pipe", name: "Underground pipe", size: (1, 1), role: UndergroundPipe(reach: 10),
        cost: [(item: "iron-plate", count: 10)]),
    (id: "tank",      name: "Tank",      size: (2, 2), role: Tank(capacity: 2500.0),
        cost: [(item: "iron-plate", count: 20), (item: "steel", count: 5)]),
    (id: "pump",      name: "Pump",      size: (1, 1), role: Pump(per_second: 1200.0), power: 30.0,
        cost: [(item: "motor", count: 1), (item: "iron-plate", count: 2)]),
    (id: "water-well", name: "Water well", size: (1, 1), role: Well(fluid: "water", per_second: 600.0), power: 90.0,
        cost: [(item: "iron-plate", count: 10), (item: "gear", count: 5), (item: "motor", count: 1)]),
    // Steam power (T30): a boiler burns coal to boil water from the pipes
    // behind and beside it into steam out of its front; a steam engine
    // burns steam into power, and gives less when the steam runs short.
    (id: "boiler",    name: "Boiler",    size: (1, 1), role: Crafter(categories: ["boiling"], speed: 1.0),
        cost: [(item: "brick", count: 5), (item: "iron-plate", count: 5)]),
    (id: "steam-engine", name: "Steam engine", size: (2, 2),
        role: Engine(kw: 300.0, fluid: "steam", per_second: 30.0),
        cost: [(item: "steel", count: 10), (item: "gear", count: 10), (item: "motor", count: 2)]),
    // Oil (T33): an oil well pumps crude; a refinery splits it, light oil
    // out of its front and tar out of its right, and takes crude from the
    // back or left. A chemical plant cracks tar and makes plastic.
    (id: "oil-well",  name: "Oil well",  size: (1, 1), role: Well(fluid: "crude-oil", per_second: 200.0), power: 150.0,
        cost: [(item: "steel", count: 10), (item: "gear", count: 10), (item: "motor", count: 2)]),
    (id: "refinery",  name: "Refinery",  size: (2, 2), role: Crafter(categories: ["refining"], speed: 1.0), power: 200.0,
        cost: [(item: "steel", count: 15), (item: "brick", count: 10), (item: "circuit", count: 10)]),
    (id: "chemical-plant", name: "Chemical plant", size: (1, 1), role: Crafter(categories: ["chemistry"], speed: 1.0), power: 120.0,
        cost: [(item: "steel", count: 5), (item: "gear", count: 5), (item: "circuit", count: 5)]),
    // Plastic's first use: an assembler twice as fast, light enough to need power.
    (id: "fast-assembler", name: "Fast assembler", size: (1, 1), role: Crafter(categories: ["assembling"], speed: 2.0), power: 90.0,
        cost: [(item: "plastic", count: 10), (item: "motor", count: 2), (item: "circuit", count: 10)]),
    // Railways (T46-T47): track joins whatever track is beside it; signals
    // split it into blocks one train at a time; trains load at stops from
    // belts pointed in, and unload out of the side a stop faces.
    (id: "rail",       name: "Rail",       size: (1, 1), role: Rail,
        cost: [(item: "steel", count: 1), (item: "iron-plate", count: 1)]),
    (id: "rail-signal", name: "Rail signal", size: (1, 1), role: RailSignal,
        cost: [(item: "steel", count: 1), (item: "circuit", count: 2)]),
    (id: "train-stop", name: "Train stop", size: (1, 1), role: TrainStop,
        cost: [(item: "steel", count: 5), (item: "circuit", count: 5), (item: "brick", count: 5)]),
    (id: "locomotive", name: "Locomotive", size: (1, 1), role: Locomotive(tiles_per_second: 8.0, capacity: 200),
        cost: [(item: "steel", count: 20), (item: "motor", count: 10), (item: "circuit", count: 10)]),
    // Oil by train (S5): a tank train fills from pipes beside a stop and
    // empties into a pipe out of the stop's arrow. `capacity` is fluid units.
    (id: "tank-train", name: "Tank train", size: (1, 1), role: Locomotive(tiles_per_second: 8.0, capacity: 2500, tank: true),
        cost: [(item: "steel", count: 25), (item: "motor", count: 10), (item: "circuit", count: 10), (item: "iron-plate", count: 20)]),
    // Tier 4-5 (T53, T57): a furnace that smelts with power instead of fire,
    // solar panels that need no fuel, and an assembler three times as fast.
    (id: "electric-furnace", name: "Electric furnace", size: (1, 1), role: Crafter(categories: ["smelting"], speed: 2.0), power: 180.0,
        cost: [(item: "steel", count: 10), (item: "advanced-circuit", count: 5), (item: "brick", count: 10)]),
    (id: "solar-panel", name: "Solar panel", size: (2, 2), role: Generator(kw: 300.0),
        cost: [(item: "silicon", count: 15), (item: "steel", count: 5), (item: "advanced-circuit", count: 5)]),
    (id: "precision-assembler", name: "Precision assembler", size: (2, 2), role: Crafter(categories: ["assembling"], speed: 3.0), power: 150.0,
        cost: [(item: "processor", count: 5), (item: "robot-frame", count: 2), (item: "steel", count: 10)]),
    // Tier 6 (T56): a drill three times as fast, driven by an electric engine.
    (id: "deep-drill", name: "Deep drill", size: (1, 1), role: Miner(seconds_per_ore: 0.4), power: 120.0,
        cost: [(item: "titanium-plate", count: 10), (item: "electric-engine", count: 2), (item: "processor", count: 2)]),
    // The megaproject (T54): belt in each stage's parts and the skyhook
    // climbs out of sight. Finishing it wins the game.
    (id: "skyhook", name: "Skyhook", size: (3, 3),
        role: Megaproject(stages: [
            (name: "Anchor", needs: [(item: "tether-segment", count: 300), (item: "steel", count: 2000)]),
            (name: "Tether", needs: [(item: "tether-segment", count: 1000), (item: "superconductor", count: 1000)]),
            (name: "Climbers", needs: [(item: "climber", count: 60)]),
            (name: "Beacon", needs: [(item: "orbital-beacon", count: 15)]),
            (name: "Counterweight", needs: [(item: "counterweight", count: 30)]),
        ]),
        cost: [(item: "steel", count: 200), (item: "titanium-plate", count: 100), (item: "ai-core", count: 10)]),
]
