// Items and fluids. `color` is a key in the art kit's palette; `tier` is the research tier that first uses it.
[
    (id: "iron-ore",     name: "Iron ore",     kind: Solid, shape: Ore,     color: "iron-ore",   tier: 1),
    (id: "copper-ore",   name: "Copper ore",   kind: Solid, shape: Ore,     color: "copper-ore", tier: 1),
    (id: "iron-plate",   name: "Iron plate",   kind: Solid, shape: Plate,   color: "iron",       tier: 1),
    (id: "copper-plate", name: "Copper plate", kind: Solid, shape: Plate,   color: "copper",     tier: 1),
    (id: "gear",         name: "Gear",         kind: Solid, shape: Gear,    color: "iron",       tier: 1),
    (id: "wire",         name: "Copper wire",  kind: Solid, shape: Wire,    color: "copper",     tier: 1),
    (id: "circuit",      name: "Circuit",      kind: Solid, shape: Circuit, color: "circuit",    tier: 1),
    (id: "stone",        name: "Stone",        kind: Solid, shape: Ore,     color: "stone",      tier: 1),
    (id: "brick",        name: "Brick",        kind: Solid, shape: Plate,   color: "brick",      tier: 1),
    (id: "survey-pack",  name: "Survey pack",  kind: Solid, shape: Pack,    color: "pack-survey", tier: 1),
    // Tier 2: steel and motors.
    (id: "coal",         name: "Coal",         kind: Solid, shape: Ore,     color: "coal",       tier: 2),
    (id: "steel",        name: "Steel",        kind: Solid, shape: Plate,   color: "steel",      tier: 2),
    (id: "motor",        name: "Motor",        kind: Solid, shape: Gear,    color: "motor",      tier: 2),
    (id: "engineering-pack", name: "Engineering pack", kind: Solid, shape: Pack, color: "pack-engineering", tier: 2),
    // Fluids (T31) travel in pipes, never on belts or in stock.
    (id: "water",        name: "Water",        kind: Fluid, shape: Droplet, color: "water",      tier: 2),
    (id: "steam",        name: "Steam",        kind: Fluid, shape: Droplet, color: "steam",      tier: 2),
    // Tier 3: oil (T33). A refinery splits crude into light oil and tar;
    // cracking turns the tar into more light oil, and light oil makes plastic.
    (id: "crude-oil",    name: "Crude oil",    kind: Fluid, shape: Droplet, color: "crude-oil",  tier: 3),
    (id: "light-oil",    name: "Light oil",    kind: Fluid, shape: Droplet, color: "light-oil",  tier: 3),
    (id: "tar",          name: "Tar",          kind: Fluid, shape: Droplet, color: "tar",        tier: 3),
    (id: "plastic",      name: "Plastic",      kind: Solid, shape: Plate,   color: "plastic",    tier: 3),
    // Far raw materials, each found only in its own biome (T42): the world
    // numbers ores in this order, so these three follow iron, copper, stone
    // and coal as desert, tundra and volcanic ore.
    (id: "bauxite",      name: "Bauxite",      kind: Solid, shape: Ore,     color: "bauxite",    tier: 5),
    (id: "titanium-ore", name: "Titanium ore", kind: Solid, shape: Ore,     color: "titanium-ore", tier: 6),
    (id: "rare-earth",   name: "Rare earths",  kind: Solid, shape: Ore,     color: "rare-earth", tier: 7),
    // Tier 4: chemistry and electronics (T53). Tar gives up its sulfur, the
    // acid makes batteries, and plastic boards make advanced circuits.
    (id: "sulfur",       name: "Sulfur",       kind: Solid, shape: Powder,  color: "sulfur",     tier: 4),
    (id: "sulfuric-acid", name: "Sulfuric acid", kind: Fluid, shape: Droplet, color: "sulfuric-acid", tier: 4),
    (id: "battery",      name: "Battery",      kind: Solid, shape: Cell,    color: "battery",    tier: 4),
    (id: "advanced-circuit", name: "Advanced circuit", kind: Solid, shape: Circuit, color: "advanced-circuit", tier: 4),
    (id: "chemistry-pack", name: "Chemistry pack", kind: Solid, shape: Pack, color: "pack-chemistry", tier: 4),
    // Tier 5: precision. Silicon wafers etched in acid become processors,
    // and processors drive robot frames.
    (id: "silicon",      name: "Silicon wafer", kind: Solid, shape: Wafer,  color: "silicon",    tier: 5),
    (id: "processor",    name: "Processor",    kind: Solid, shape: Chip,    color: "processor",  tier: 5),
    (id: "robot-frame",  name: "Robot frame",  kind: Solid, shape: Frame,   color: "robot-frame", tier: 5),
    (id: "low-density-structure", name: "Low density structure", kind: Solid, shape: Plate, color: "low-density", tier: 5),
    (id: "precision-pack", name: "Precision pack", kind: Solid, shape: Pack, color: "pack-precision", tier: 5),
]
