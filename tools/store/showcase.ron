        At(building: "wind-turbine", x: 25, y: 15, dir: East),
        At(building: "wind-turbine", x: 25, y: 17, dir: East),
        At(building: "wind-turbine", x: 27, y: 15, dir: East),
        At(building: "wind-turbine", x: 27, y: 17, dir: East),
        At(building: "wind-turbine", x: 29, y: 15, dir: East),
        At(building: "wind-turbine", x: 29, y: 17, dir: East),
        At(building: "wind-turbine", x: 31, y: 15, dir: East),
