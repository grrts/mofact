        At(building: "drill", x: 5, y: 30, dir: East),
        Belts(x: 6, y: 30, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 30, dir: East),
        Belts(x: 9, y: 30, len: 1, dir: East),
        At(building: "assembler", x: 10, y: 30, dir: East, recipe: Some("wire")),
        Belts(x: 11, y: 30, len: 9, dir: East),
        // Everything joins a fast belt south into the hub.
        Line(building: "fast-belt", x: 20, y: 13, len: 19, dir: South),
        At(building: "hub", x: 19, y: 32, dir: East),
        // Wind turbines on a pole line.
        At(building: "wind-turbine", x: 23, y: 15, dir: East),
