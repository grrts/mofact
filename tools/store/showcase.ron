// The factory the store screenshots show (docs/store): a few minutes into a
// game, with smelting, gears, wire and circuits on belts into a hub, wind
// turbines on poles, and an ore train. `mofact --store DIR --scenario
// tools/store/showcase.ron` photographs it after `warmup_seconds`.
//
// Everything here is built with the game's own buildings and recipes, on
// grassland near the start of the default map (seed 42). Some lines make
// more than the next machine takes and back up after a minute or two, so
// the photo is taken before that, with every machine working.
(
    name: "Store showcase",
    stock: [
        ("iron-plate", 2000), ("copper-plate", 500), ("gear", 200), ("wire", 200),
        ("steel", 500), ("circuit", 200), ("motor", 50), ("brick", 50),
    ],
    ore: [(5, 13, "iron-ore"), (5, 14, "iron-ore"), (5, 16, "iron-ore"), (5, 17, "iron-ore"), (5, 21, "iron-ore"), (5, 22, "iron-ore"), (5, 24, "copper-ore"), (5, 27, "copper-ore"), (5, 28, "copper-ore"), (5, 30, "copper-ore"), (27, 11, "iron-ore"), (28, 11, "iron-ore"), (29, 11, "iron-ore"), (30, 11, "iron-ore")],
    patches: [
        (4.5, 17.0, 5.5, "iron-ore"),
        (4.5, 27.5, 4.5, "copper-ore"),
        (28.5, 11.5, 2.2, "iron-ore"),
    ],
    research: ["steel-working", "motors", "logistics", "fast-belts", "railways"],
    build: [
        // Iron plates.
        At(building: "drill", x: 5, y: 13, dir: East),
        Belts(x: 6, y: 13, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 13, dir: East),
        Belts(x: 9, y: 13, len: 1, dir: East),
        Belts(x: 10, y: 13, len: 10, dir: East),
        At(building: "drill", x: 5, y: 14, dir: East),
        Belts(x: 6, y: 14, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 14, dir: East),
        Belts(x: 9, y: 14, len: 1, dir: East),
        Belts(x: 10, y: 14, len: 10, dir: East),
        // Two iron lines into a gear assembler, one from behind and one from above.
        At(building: "drill", x: 5, y: 16, dir: East),
        Belts(x: 6, y: 16, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 16, dir: East),
        Belts(x: 9, y: 16, len: 1, dir: East),
        Belts(x: 10, y: 16, len: 1, dir: South),
        At(building: "drill", x: 5, y: 17, dir: East),
        Belts(x: 6, y: 17, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 17, dir: East),
        Belts(x: 9, y: 17, len: 1, dir: East),
        At(building: "assembler", x: 10, y: 17, dir: East, recipe: Some("gear")),
        Belts(x: 11, y: 17, len: 9, dir: East),
        // Circuits: gears from above and wire from the left.
        At(building: "drill", x: 5, y: 21, dir: East),
        Belts(x: 6, y: 21, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 21, dir: East),
        Belts(x: 9, y: 21, len: 1, dir: East),
        Belts(x: 10, y: 21, len: 1, dir: South),
        At(building: "drill", x: 5, y: 22, dir: East),
        Belts(x: 6, y: 22, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 22, dir: East),
        Belts(x: 9, y: 22, len: 1, dir: East),
        At(building: "assembler", x: 10, y: 22, dir: East, recipe: Some("gear")),
        Belts(x: 11, y: 22, len: 3, dir: East),
        Belts(x: 14, y: 22, len: 1, dir: South),
        At(building: "drill", x: 5, y: 24, dir: East),
        Belts(x: 6, y: 24, len: 2, dir: East),
        At(building: "furnace", x: 8, y: 24, dir: East),
        Belts(x: 9, y: 24, len: 1, dir: East),
        At(building: "assembler", x: 10, y: 24, dir: East, recipe: Some("wire")),
        Belts(x: 11, y: 24, len: 2, dir: East),
        Belts(x: 13, y: 24, len: 1, dir: North),
        Belts(x: 13, y: 23, len: 1, dir: East),
        At(building: "assembler", x: 14, y: 23, dir: East, recipe: Some("circuit")),
        Belts(x: 15, y: 23, len: 5, dir: East),
        // Copper plates and wire.
        At(building: "drill", x: 5, y: 27, dir: East),
