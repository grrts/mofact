        At(building: "train-stop", x: 35, y: 9, dir: North),
        At(building: "belt", x: -4, y: 10, dir: North),
        Belts(x: 30, y: 10, len: 34, dir: West),
        At(building: "drill", x: 27, y: 11, dir: North),
        At(building: "drill", x: 28, y: 11, dir: North),
        At(building: "drill", x: 29, y: 11, dir: North),
        At(building: "drill", x: 30, y: 11, dir: North),
        Train(building: "locomotive", x: 10, y: 9, dir: West, stops: [(-4, 9, true), (35, 9, false)]),
    ],
    warmup_seconds: 30,
    measure_seconds: 0,
    expect: [],
