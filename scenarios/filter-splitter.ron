// Iron and copper plates merged on one belt, sorted by a filter splitter:
// copper goes straight on into the hub, iron out of the sides and round into
// it. One drill and furnace per line (1.2 s each): 50 of each a minute, so
// the splitter keeps both lines moving at full speed.
(
    name: "Filter splitter",
    stock: [("iron-plate", 100), ("circuit", 20)],
    ore: [(19, 27, "iron-ore"), (19, 24, "copper-ore")],
    research: ["logistics"],
    build: [
        At(building: "hub", x: 26, y: 26, dir: East),
        // Iron along y = 27, copper along y = 24 and down onto it.
        At(building: "drill", x: 19, y: 27, dir: East),
        Belts(x: 20, y: 27, len: 2, dir: East),
        At(building: "furnace", x: 22, y: 27, dir: East),
        Belts(x: 23, y: 27, len: 1, dir: East),
        At(building: "drill", x: 19, y: 24, dir: East),
        Belts(x: 20, y: 24, len: 2, dir: East),
        At(building: "furnace", x: 22, y: 24, dir: East),
        Belts(x: 23, y: 24, len: 3, dir: South),
        At(building: "filter-splitter", x: 24, y: 27, dir: East, filter: Some("copper-plate")),
        Belts(x: 25, y: 27, len: 1, dir: East),
        Belts(x: 24, y: 26, len: 2, dir: East),
        Belts(x: 24, y: 28, len: 2, dir: East),
    ],
    warmup_seconds: 60,
    measure_seconds: 180,
    expect: [
        (item: "copper-plate", per_minute: 50.0, tolerance: 1.0),
        (item: "iron-plate", per_minute: 50.0, tolerance: 1.0),
    ],
)
